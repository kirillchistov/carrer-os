# Copy to `.env` and fill in. Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Server-only.
SUPABASE_SERVICE_ROLE_KEY=""

# Transaction pooler (port 6543) — Prisma at runtime. Copy from Supabase → Database → Connect → Transaction.
# Host MUST be `*.pooler.supabase.com`. `db.<project>.supabase.co` is IPv6-only and 500s on Vercel.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"
# Direct connection (port 5432) — prisma migrate only (local / CI).
DIRECT_URL="postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

ANTHROPIC_API_KEY=""

# Required in production (public https origin, no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
