# Copy to `.env` and fill in. Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Server-only.
SUPABASE_SERVICE_ROLE_KEY=""

# Pooled connection (pgbouncer, port 6543) — Prisma at runtime.
DATABASE_URL="postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — prisma migrate only.
DIRECT_URL="postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

ANTHROPIC_API_KEY=""

# Required in production (public https origin, no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
