# Copy to `.env` and fill in. Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Server-only.
SUPABASE_SERVICE_ROLE_KEY=""

# Transaction pooler (port 6543) — Prisma at runtime. Copy from Supabase → Database → Connect → Transaction.
# Host MUST be `*.pooler.supabase.com`. `db.<project>.supabase.co` is IPv6-only and fails on Vercel.
# Do not add sslmode=require — node-pg treats it as verify-full and rejects Supabase TLS.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Direct connection (port 5432) — prisma migrate only (local / CI).
DIRECT_URL="postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"
# Used when DATABASE_URL still points at db.*.supabase.co; the app rewrites it to the pooler.
SUPABASE_REGION="eu-west-3"

ANTHROPIC_API_KEY=""

# Required in production (public https origin, no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Optional product analytics. Events stay IDs/enums only (see src/lib/analytics/track.ts).
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
